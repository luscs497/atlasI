# Copie para .env e preencha. O .env nunca vai para o repositório.

# OpenAI API — cérebro atual do JARVIS (ia_provider=openai, gpt-4o-mini)
# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API — cérebro alternativo (ia_provider=gemini)
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude API (Anthropic) — alternativa futura
ANTHROPIC_API_KEY=

# ElevenLabs — TTS (fase futura)
ELEVENLABS_API_KEY=

# Opcional: força um interpretador Python específico para o backend
# JARVIS_PYTHON=/caminho/para/python

# Perplexity — busca em tempo real (Sonar online). https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Capacete (ESP32) — token compartilhado com o firmware (backend helmet/).
# Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
HELMET_TOKEN=
# Idioma do capacete: pt | en (en = voz britânica bm_daniel, estilo JARVIS)
HELMET_LANGUAGE=pt
HELMET_TTS_VOICE=
