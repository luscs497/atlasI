#!/usr/bin/env bash
# Launcher do ATLAS I. Crie um alias global apontando para este arquivo:
#   echo "alias atlas='$HOME/projetos/atlasI/scripts/atlas'" >> ~/.bashrc
set -euo pipefail

# Diretório raiz do projeto (um nível acima de scripts/).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

exec npm start
